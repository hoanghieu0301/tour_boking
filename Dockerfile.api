FROM node:22-alpine AS builder

WORKDIR /app

# Copy dependency configs
COPY package*.json ./
COPY tsconfig*.json ./
COPY nest-cli.json ./
COPY src/api/prisma.config.ts ./src/api/prisma.config.ts
COPY src/api/prisma ./src/api/prisma

RUN npm install

# Copy source code
COPY src ./src

# Generate prisma client and build NestJS
RUN npm run prisma:generate
RUN npm run build

# Runner stage
FROM node:22-alpine AS runner
WORKDIR /app

ENV NODE_ENV=production
ENV PORT=4000

COPY --from=builder /app/package*.json ./
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/dist ./dist
COPY --from=builder /app/src/api/prisma ./src/api/prisma
COPY --from=builder /app/src/api/prisma.config.ts ./src/api/prisma.config.ts

EXPOSE 4000

# Tự động đẩy schema database trước khi khởi động server
CMD ["sh", "-c", "npx prisma db push --config src/api/prisma.config.ts && node dist/main.js"]
